#!/bin/bash
set -euo pipefail

# Use the active Xcode toolchain (local or GitHub Actions).
DOCC="${DOCC:-$(xcrun --find docc)}"

# Scheme matches the package/product name. Override with SCHEME= when the
# checkout directory is not named HTTPClient.
SCHEME="${SCHEME:-$(basename "$(pwd)")}"
DESTINATION="${DESTINATION:-generic/platform=macOS}"

rm -rf .build build docs

xcodebuild_args=(
  docbuild
  -scheme "$SCHEME"
  -destination "$DESTINATION"
  -derivedDataPath build
)

if [[ -n "${CI:-}" ]]; then
  xcodebuild "${xcodebuild_args[@]}"
else
  xcodebuild "${xcodebuild_args[@]}" > /dev/null
fi

ARCHIVE="$(find build -name "${SCHEME}.doccarchive" -print -quit)"
if [[ -z "$ARCHIVE" ]]; then
  echo "error: ${SCHEME}.doccarchive not found under ./build" >&2
  exit 1
fi

if [[ -n "${CI:-}" ]]; then
  "$DOCC" process-archive transform-for-static-hosting \
    --output-path ./docs \
    "$ARCHIVE"
else
  "$DOCC" process-archive transform-for-static-hosting \
    --output-path ./docs \
    "$ARCHIVE" > /dev/null
fi
